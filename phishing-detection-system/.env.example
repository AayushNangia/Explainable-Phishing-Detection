# ---- Backend ----
FRONTEND_ORIGIN=http://localhost:5173
# Leave MONGODB_URI empty to use LOCAL FILE MODE (development fallback, clearly labelled in the UI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=phishing_detection
# Privacy: never store raw email bodies unless you explicitly enable this
STORE_FULL_INPUT=false
# Use this to force local file storage even if MongoDB is installed
FORCE_LOCAL_STORAGE=false
